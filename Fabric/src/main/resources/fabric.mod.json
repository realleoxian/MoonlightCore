{
  "schemaVersion": 1,
  "id": "moonlightcore",
  "version": "${version}",
  "name": "Moonlight Core",
  "description": "MoonlightCore is a layer abstraction that simplifies the process of creating multi-loader mods by prividing loader-agnostic APIs",
  "authors": ["Leoxian"],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "moonlightcore.accesswidener",
  "entrypoints": {
    "main": ["de.leoxian.moonlightcore.fabric.MoonlightCoreFabric"],
    "client": ["de.leoxian.moonlightcore.fabric.MoonlightCoreClientFabric"]
  },
  "mixins": [
    "moonlightcore.mixins.json",
    "moonlightcore.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": ">=${fabricApiVersion}"
  }
}