# Examples category of Bleom's Simple Config Language
[examples]

# An example integer config
exampleInt = 100
exampleBoolean = true
exampleFloat = 90.5

# An array of ints
exampleIntArray = [90, 10, 80, 50, 20, 40]

[examples.strings]
exampleUnquotedStrings = Hello, I'm an unquoted string config
exampleQuotedString = "Hello, I'm a quoted string config"
exampleMultilineString = r#"
    Hello
    I'm
    An
    Multiline
    String
    Config      ----        YIPIIEE :D
"#r